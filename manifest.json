{
  "manifest_version": 3,
  "name": "CleanTube – Stay Focused",
  "description": "Stay focused by removing short-form videos and distractions.",
  "version": "0.0.5",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.tiktok.com/*",
    "*://www.instagram.com/*",
    "*://www.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.tiktok.com/*",
        "*://www.instagram.com/*",
        "*://www.facebook.com/*"
      ],
      "js": [
        "index.js"
      ],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "CleanTube.html"
      ],
      "matches": [
        "*://www.tiktok.com/*"
      ]
    }
  ]
}